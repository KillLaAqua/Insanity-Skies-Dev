		{
			dependencies: ["6D05E6DC441E77C2"]
			description: [
				"The item pipe allows you to transfer items from one container to another at a rate of 1 item every 5 ticks."
				""
				"The pipe automatically connects to containers that can store items. By shift right-clicking with any wrench, you can switch it to import mode. Import mode lets the pipe pull from the conneced container. The items will then be exported to the nearest container connected to the pipe."
				""
				"Can be upgraded and filtered."
			]
			id: "29B0C15EAD1C0094"
			tasks: [{
				id: "6196B1EB8B856259"
				item: "pipez:item_pipe"
				type: "item"
